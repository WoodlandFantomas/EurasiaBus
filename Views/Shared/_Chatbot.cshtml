
<div id="chatbot">

    <!-- ========================================================
         BUTTON
         ======================================================== -->

    <button id="chatbot-toggle"
            type="button"
            aria-label="Открыть EurasiaBus Support">

        💬

    </button>


    <!-- ========================================================
         CHAT WINDOW
         ======================================================== -->

    <div id="chatbot-window">

        <!-- HEADER -->

        <div id="chatbot-header">

            <div>

                <strong>
                    🚌 EurasiaBus Support
                </strong>

                <small>
                    Помощь по бронированию автобусов
                </small>

            </div>


            <button id="chatbot-close"
                    type="button"
                    aria-label="Закрыть чат">

                ×

            </button>

        </div>


        <!-- ====================================================
             MESSAGES
             ==================================================== -->

        <div id="chatbot-messages">

            <div class="chatbot-message chatbot-bot">

                <div class="chatbot-message-content">

                    👋 Здравствуйте!

                    <br />

                    Я EurasiaBus Support.

                    <br />

                    Чем я могу вам помочь?

                </div>

            </div>

        </div>


        <!-- ====================================================
             QUICK QUESTIONS
             ==================================================== -->

        <div id="chatbot-quick-buttons">

            <button type="button"
                    class="chatbot-quick-btn"
                    data-message="Как найти автобус?">

                🔎 Найти автобус

            </button>


            <button type="button"
                    class="chatbot-quick-btn"
                    data-message="Как купить билет?">

                🎟️ Купить билет

            </button>


            <button type="button"
                    class="chatbot-quick-btn"
                    data-message="Как выбрать место?">

                💺 Выбрать место

            </button>


            <button type="button"
                    class="chatbot-quick-btn"
                    data-message="Как оплатить билет?">

                💳 Оплата

            </button>


            <button type="button"
                    class="chatbot-quick-btn"
                    data-message="Где мои билеты?">

                🎫 Мои билеты

            </button>

        </div>


        <!-- ====================================================
             INPUT
             ==================================================== -->

        <div id="chatbot-input-area">

            <input id="chatbot-input"
                   type="text"
                   placeholder="Введите вопрос..."
                   autocomplete="off" />


            <button id="chatbot-send"
                    type="button"
                    aria-label="Отправить">

                ➤

            </button>

        </div>

    </div>

</div>


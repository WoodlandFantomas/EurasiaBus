
@using EurasiaBus.Models
@using BusRoute = EurasiaBus.Models.Route

@model BusSearchViewModel

@{
    ViewData["Title"] = "EurasiaBus";

    var routes = ViewBag.Routes as List<BusRoute>
                  ?? new List<BusRoute>();

    var stops = ViewBag.Stops as List<BusStop>
                ?? new List<BusStop>();

    var routeError = ViewBag.RouteError as string;
}

<div class="container-fluid px-3 px-md-4">

    <!-- ========================================= -->
    <!-- ПОИСК БИЛЕТА -->
    <!-- ========================================= -->

    <div class="row justify-content-center mb-4">
        <div class="col-12 col-xl-10">

            <div class="card shadow-sm border-0">

                <div class="card-body p-3 p-md-4">

                    <h2 class="text-center mb-4">
                        <i class="bi bi-bus-front"></i>
                        Поиск автобусных билетов
                    </h2>

                    <form asp-action="Search"
                          asp-controller="Home"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <!-- ================================= -->
                            <!-- ОТКУДА -->
                            <!-- ================================= -->

                            <div class="col-12 col-md-6">

                                <label asp-for="DepartureStopId"
                                       class="form-label">
                                    Откуда
                                </label>

                                <select asp-for="DepartureStopId"
                                        class="form-select">

                                    <option value="">
                                        Выберите город отправления
                                    </option>

                                    @foreach (var stop in stops)
                                    {
                                        <option value="@stop.BusStopId">
                                            @stop.City
                                            @if (!string.IsNullOrWhiteSpace(stop.Name))
                                            {
                                                <text> - @stop.Name</text>
                                            }
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="DepartureStopId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================= -->
                            <!-- КУДА -->
                            <!-- ================================= -->

                            <div class="col-12 col-md-6">

                                <label asp-for="ArrivalStopId"
                                       class="form-label">
                                    Куда
                                </label>

                                <select asp-for="ArrivalStopId"
                                        class="form-select">

                                    <option value="">
                                        Выберите город прибытия
                                    </option>

                                    @foreach (var stop in stops)
                                    {
                                        <option value="@stop.BusStopId">
                                            @stop.City
                                            @if (!string.IsNullOrWhiteSpace(stop.Name))
                                            {
                                                <text> - @stop.Name</text>
                                            }
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="ArrivalStopId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================= -->
                            <!-- ДАТА -->
                            <!-- ================================= -->

                            <div class="col-12 col-md-4">

                                <label asp-for="DepartureDate"
                                       class="form-label">
                                    Дата поездки
                                </label>

                                <input asp-for="DepartureDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DepartureDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================= -->
                            <!-- ПАССАЖИРЫ -->
                            <!-- ================================= -->

                            <div class="col-12 col-md-4">

                                <label asp-for="Passengers"
                                       class="form-label">
                                    Пассажиры
                                </label>

                                <input asp-for="Passengers"
                                       type="number"
                                       min="1"
                                       max="10"
                                       class="form-control" />

                                <span asp-validation-for="Passengers"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================= -->
                            <!-- ПОИСК -->
                            <!-- ================================= -->

                            <div class="col-12 col-md-4 d-flex align-items-end">

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    <i class="bi bi-search"></i>
                                    Найти автобус

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>


    <!-- ========================================= -->
    <!-- МАРШРУТЫ ИЗ EXCEL -->
    <!-- ========================================= -->

    <div class="row justify-content-center">

        <div class="col-12 col-xl-11">

            <div class="card shadow-sm border-0">

                <!-- Заголовок -->

                <div class="card-header bg-primary text-white py-2">

                    <h5 class="mb-0">

                        <i class="bi bi-bus-front"></i>

                        Автобусные маршруты по Европе

                    </h5>

                </div>


                <div class="card-body p-0">

                    <!-- ================================= -->
                    <!-- ОШИБКА EXCEL -->
                    <!-- ================================= -->
                    @if (!string.IsNullOrWhiteSpace(routeError))
                    {
                        <div class="alert alert-danger m-3">

                            <strong>Ошибка:</strong>

                            @routeError

                        </div>
                    }


                    <!-- ================================= -->
                    <!-- НЕТ МАРШРУТОВ -->
                    <!-- ================================= -->
                    @if (routes.Count == 0)
                    {
                        <div class="alert alert-warning m-3">

                            <i class="bi bi-exclamation-triangle"></i>

                            В Excel-файле не найдено ни одного маршрута.

                            <br />

                            Формат:

                            <strong>
                                A = Откуда,
                                B = Маршрут,
                                C = Цена,
                                D = Куда
                            </strong>

                        </div>
                    }
                    else
                    {
                        <!-- ================================= -->
                        <!-- ТАБЛИЦА МАРШРУТОВ -->
                        <!-- ================================= -->

                        <div class="table-responsive">

                            <table class="table table-striped table-hover table-sm mb-0 route-table">

                                <thead class="table-light">

                                    <tr>

                                        <th>
                                            Откуда
                                        </th>

                                        <th>
                                            Маршрут
                                        </th>

                                        <th class="text-end">
                                            Цена
                                        </th>

                                        <th>
                                            Куда
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var route in routes)
                                    {
                                        /*
                                         * В Excel колонка B:
                                         *
                                         * Оратів|Вінниця|Львів|Варшава
                                         *
                                         * В таблице показываем:
                                         *
                                         * Оратів → Вінниця → Львів → Варшава
                                         *
                                         * Сам Excel-файл не изменяется.
                                         */

                                        string displayRoute =
                                            route.RoutePath.Replace("|", " → ");

                                        <tr>

                                            <!-- ОТКУДА -->

                                            <td class="route-from">
                                                @route.From
                                            </td>


                                            <!-- МАРШРУТ -->

                                            <td class="route-path">
                                                @displayRoute
                                            </td>


                                            <!-- ЦЕНА -->

                                            <td class="route-price text-end">
                                                €@route.Price.ToString("N2")
                                            </td>


                                            <!-- КУДА -->

                                            <td class="route-to">
                                                @route.To
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================= -->
<!-- СТИЛИ -->
<!-- ========================================= -->

<style>

    .route-table {
        font-size: 0.88rem;
        margin-bottom: 0;
    }

        .route-table th {
            white-space: nowrap;
            padding: 6px 8px;
            font-weight: 600;
            vertical-align: middle;
        }

        .route-table td {
            padding: 5px 8px;
            vertical-align: middle;
            line-height: 1.2;
        }

    .route-from {
        white-space: nowrap;
        font-weight: 500;
    }

    .route-path {
        white-space: nowrap;
    }

    .route-price {
        white-space: nowrap;
        font-weight: 600;
    }

    .route-to {
        white-space: nowrap;
        font-weight: 500;
    }

    .route-table tbody tr {
        transition: background-color 0.15s ease;
    }


    /* В Razor необходимо писать @@media */

    @@media (max-width: 768px) {

        .route-table {
            font-size: 0.78rem;
        }

            .route-table th,
            .route-table td {
                padding: 4px 6px;
            }

        .route-path {
            white-space: normal;
            min-width: 220px;
        }

        .route-from,
        .route-to {
            white-space: nowrap;
        }
    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}


@model IEnumerable<BusTrip>
@{ ViewData["Title"] = "Search results"; }<h2>Available bus trips</h2><div class="row g-4">@foreach(var trip in Model){<div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-body"><h5>@trip.DepartureStop.City → @trip.ArrivalStop.City</h5><p class="mb-1">@trip.DepartureDateTime.ToString("dd MMM yyyy HH:mm") → @trip.ArrivalDateTime.ToString("HH:mm")</p><p>@trip.Bus.Name · @trip.Bus.Model</p><strong>€ @trip.Price.ToString("N2")</strong><a class="btn btn-primary float-end" asp-controller="Booking" asp-action="SelectSeats" asp-route-id="@trip.BusTripId">Select</a></div></div></div>}</div>

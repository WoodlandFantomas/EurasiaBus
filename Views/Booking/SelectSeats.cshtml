<script>

    document.addEventListener("DOMContentLoaded", function() {

        const maxSeats = @passengers;

        const pricePerSeat =
            @Model.Price.ToString(
            System.Globalization.CultureInfo.InvariantCulture
            );

        const checkboxes =
            document.querySelectorAll(".seat-checkbox");

        const selectedSeatsElement =
            document.getElementById("selectedSeats");

        const selectedCountElement =
            document.getElementById("selectedCount");

        const progressElement =
            document.getElementById("seatProgress");

        const totalPriceElement =
            document.getElementById("totalPrice");

        const continueButton =
            document.getElementById("continueButton");


        function updateSelection() {

            const selected =
                Array.from(checkboxes)
                    .filter(function(checkbox) {
                        return checkbox.checked;
                    });


            /*
             * Если выбрано максимальное количество,
             * блокируем остальные свободные места.
             */

            if (selected.length >= maxSeats) {

                checkboxes.forEach(function(checkbox) {

                    if (!checkbox.checked && !checkbox.disabled) {
                        checkbox.disabled = true;
                    }

                });

            }
            else {

                checkboxes.forEach(function(checkbox) {

                    const seat =
                        checkbox.closest(".seat");

                    if (
                        seat &&
                        seat.classList.contains("seat-available") &&
                        !checkbox.checked
                    ) {
                        checkbox.disabled = false;
                    }

                });

            }


            /*
             * Номера выбранных мест
             */

            const seatNumbers =
                selected.map(function(checkbox) {

                    const seat =
                        checkbox.closest(".seat");

                    return seat
                        .querySelector(".seat-number")
                        .textContent
                        .trim();

                });


            selectedCountElement.textContent =
                selected.length;


            if (seatNumbers.length === 0) {

                selectedSeatsElement.textContent =
                    "Пока не выбрано";

            }
            else {

                selectedSeatsElement.textContent =
                    seatNumbers.join(", ");

            }


            /*
             * Progress
             */

            const progress =
                Math.min(
                    (selected.length / maxSeats) * 100,
                    100
                );

            progressElement.style.width =
                progress + "%";


            /*
             * Цена
             */

            const total =
                selected.length * pricePerSeat;

            totalPriceElement.textContent =
                "€ " + total.toFixed(2);


            /*
             * Кнопка активна только тогда,
             * когда выбрано ровно нужное количество.
             */

            continueButton.disabled =
                selected.length !== maxSeats;

        }


        /*
         * Обработка выбора мест
         */

        checkboxes.forEach(function(checkbox) {

            checkbox.addEventListener("change", function() {

                /*
                 * Дополнительная защита:
                 * больше пассажиров выбрать нельзя.
                 */

                const selectedCount =
                    document.querySelectorAll(
                        ".seat-checkbox:checked"
                    ).length;

                if (selectedCount > maxSeats) {

                    checkbox.checked = false;

                }

                updateSelection();

            });

        });


        updateSelection();

    });

</script>

@model EurasiaBus.Models.BusTrip

@{
    ViewData["Title"] = "Выбор мест";


int passengers = ViewBag.Passengers is int p && p > 0 ? p : 1;

    var seats = Model.Seats
        .OrderBy(x =>
        {
            int number;
            return int.TryParse(x.SeatNumber, out number)
                ? number
                : int.MaxValue;
        })
        .ToList();

    var rows = new List<List<EurasiaBus.Models.BusTripSeat>>();

    for (int i = 0; i < seats.Count; i += 4)
    {
        rows.Add(seats.Skip(i).Take(4).ToList());
    }


}

<div class="container py-4">

    ```
    <div class="text-center mb-4">

        <div class="bus-title-icon mb-3">

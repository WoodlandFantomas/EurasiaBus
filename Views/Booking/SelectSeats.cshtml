                                                        <span class="seat-number">
                                                            @seat.SeatNumber
                                                        </span>

                                                    </span>

                                                </span>

                                            </label>
                                        }
                                    }

                                </div>


                                <!-- Проход -->

                                <div class="aisle"></div>


                                <!-- Правая сторона -->

                                <div class="seat-pair">

                                    @for (int seatIndex = 2; seatIndex < 4; seatIndex++)
                                    {
                                        if (seatIndex < row.Count)
                                        {
                                            var seat = row[seatIndex];

                                            <label class="seat @(seat.IsAvailable ? "seat-available" : "seat-occupied")">

                                                <input type="checkbox"
                                                       name="SelectedSeatIds"
                                                       value="@seat.BusTripSeatId"

@model IEnumerable<Booking>
@{ViewData["Title"]="My bookings";}<h2>My bookings</h2><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>PNR</th><th>Route</th><th>Date</th><th>Passenger</th><th>Seat</th><th>Price</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><strong>@b.PnrCode</strong></td><td>@b.BusTrip.DepartureStop.City → @b.BusTrip.ArrivalStop.City</td><td>@b.BusTrip.DepartureDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@b.Passenger.FirstName @b.Passenger.LastName</td><td>@b.BusTripSeat.SeatNumber</td><td>€ @b.TicketPrice.ToString("N2")</td><td>@b.Status</td></tr>}</tbody></table></div>

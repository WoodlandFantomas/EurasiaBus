@model PassengerDetailsViewModel
@{ViewData["Title"]="Passenger details";}<h2>Passenger details</h2><form asp-action="CreateBooking" method="post" class="row g-3"><input type="hidden" asp-for="TripId"/>@for(int i=0;i<Model.SeatIds.Count;i++){<input type="hidden" name="SeatIds" value="@Model.SeatIds[i]"/>}<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control"/></div><div class="col-md-6"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control"/></div><div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-6"><label asp-for="PassportNo"></label><input asp-for="PassportNo" class="form-control"/></div><div class="col-md-6"><label asp-for="BirthDate"></label><input asp-for="BirthDate" type="date" class="form-control"/></div><div><button class="btn btn-primary">Continue to payment</button></div></form>

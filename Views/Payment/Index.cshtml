@model PaymentViewModel
@{ViewData["Title"]="Payment";}<div class="row justify-content-center"><div class="col-lg-6"><div class="card shadow-sm"><div class="card-body p-4"><h2>Payment</h2><h4 class="mb-4">Total: € @Model.Amount.ToString("N2")</h4><form asp-action="Pay" method="post"><input asp-for="BookingId" type="hidden"/><input asp-for="Amount" type="hidden"/><div class="mb-3"><label>Payment method</label><select asp-for="PaymentMethod" class="form-select"><option>Card</option><option>PayPal</option></select></div><div class="mb-3"><label>Card number</label><input asp-for="CardNumber" class="form-control" placeholder="Test payment only"/></div><div class="row"><div class="col"><input asp-for="Expiry" class="form-control" placeholder="MM/YY"/></div><div class="col"><input asp-for="Cvv" class="form-control" placeholder="CVV"/></div></div><button class="btn btn-success w-100 mt-4">Pay € @Model.Amount.ToString("N2")</button></form></div></div></div></div>

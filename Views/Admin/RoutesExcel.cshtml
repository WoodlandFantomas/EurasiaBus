@{
    ViewData["Title"] = "Маршруты Excel";
}

<div class="container-fluid py-4">

    <!-- Заголовок -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-excel text-success me-2"></i>
                Маршруты
            </h2>

            <p class="text-muted mb-0">
                Управление файлом маршрутов Routes.xlsx
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Назад
        </a>
    </div>


    <!-- Сообщения -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="row g-4">

        <!-- ================================================= -->
        <!-- ТЕКУЩИЙ ФАЙЛ -->
        <!-- ================================================= -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                        Текущий файл
                    </h5>
                </div>

                <div class="card-body">

                    @if (ViewBag.FileExists == true)
                    {
                        <div class="alert alert-success">
                            <div class="d-flex align-items-center">

                                <i class="bi bi-check-circle-fill fs-3 me-3"></i>

                                <div>
                                    <strong>Routes.xlsx найден</strong>

                                    <div class="small text-muted mt-1">
                                        Файл используется для отображения
                                        маршрутов на главной странице.
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="d-grid">

                            <a asp-controller="Admin"
                               asp-action="DownloadRoutes"
                               class="btn btn-success btn-lg">

                                <i class="bi bi-download me-2"></i>

                                Скачать Routes.xlsx

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-exclamation-circle-fill fs-3 me-3"></i>

                                <div>
                                    <strong>Файл ещё не загружен</strong>

                                    <div class="small mt-1">
                                        Загрузите файл Routes.xlsx
                                        в разделе справа.
                                    </div>
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- ЗАГРУЗКА -->
        <!-- ================================================= -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-cloud-upload me-2"></i>

                        Загрузить маршруты

                    </h5>

                </div>


                <div class="card-body">

                    <form asp-controller="Admin"
                          asp-action="RoutesExcel"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label for="file"
                                   class="form-label fw-semibold">

                                Excel-файл маршрутов

                            </label>

                            <input type="file"
                                   id="file"
                                   name="file"
                                   class="form-control form-control-lg"
                                   accept=".xlsx"
                                   required />

                            <div class="form-text">

                                Разрешён только файл формата
                                <strong>.xlsx</strong>.

                            </div>

                        </div>


                        <div class="alert alert-info">

                            <h6 class="fw-bold">

                                <i class="bi bi-info-circle me-2"></i>

                                Структура Excel-файла

                            </h6>

                            <p class="mb-2">

                                Первая строка должна содержать следующие
                                столбцы:

                            </p>

                            <div class="table-responsive">

                                <table class="table table-sm table-bordered mb-0 bg-white">

                                    <thead>

                                        <tr>
                                            <th>Откуда</th>
                                            <th>Маршрут</th>
                                            <th>Цена</th>
                                            <th>Куда</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        <tr>
                                            <td>Оратів</td>

                                            <td>
                                                Оратів → Вінниця →
                                                Львів → Відень
                                            </td>

                                            <td>135</td>

                                            <td>Відень</td>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                            <div class="small mt-2">

                                Порядок столбцов не имеет значения.
                                Система автоматически найдёт нужные
                                колонки.

                            </div>

                        </div>


                        <div class="alert alert-warning">

                            <i class="bi bi-exclamation-triangle me-2"></i>

                            <strong>Внимание:</strong>

                            загрузка нового файла заменит текущий
                            <strong>Routes.xlsx</strong>.

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                <i class="bi bi-cloud-upload me-2"></i>

                                Загрузить файл

                            </button>


                            <a asp-controller="Admin"
                               asp-action="Dashboard"
                               class="btn btn-outline-secondary btn-lg">

                                Отмена

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- ПАМЯТКА -->
    <!-- ================================================= -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-question-circle text-primary me-2"></i>

                Как работать с маршрутами

            </h5>

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="d-flex">

                        <div class="me-3">

                            <span class="badge bg-primary rounded-circle fs-6">
                                1
                            </span>

                        </div>

                        <div>

                            <strong>Скачайте файл</strong>

                            <p class="text-muted small mb-0">
                                Используйте кнопку
                                «Скачать Routes.xlsx».
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="d-flex">

                        <div class="me-3">

                            <span class="badge bg-primary rounded-circle fs-6">
                                2
                            </span>

                        </div>

                        <div>

                            <strong>Измените Excel</strong>

                            <p class="text-muted small mb-0">
                                Добавьте или измените маршруты
                                в Excel.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="d-flex">

                        <div class="me-3">

                            <span class="badge bg-primary rounded-circle fs-6">
                                3
                            </span>

                        </div>

                        <div>

                            <strong>Сохраните файл</strong>

                            <p class="text-muted small mb-0">
                                Сохраните его в формате
                                <strong>.xlsx</strong>.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="d-flex">

                        <div class="me-3">

                            <span class="badge bg-success rounded-circle fs-6">
                                4
                            </span>

                        </div>

                        <div>

                            <strong>Загрузите обратно</strong>

                            <p class="text-muted small mb-0">
                                Новый список сразу станет доступен
                                на главной странице.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@using EurasiaBus.Models
@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Бронирования";

    var bookings = Model?.ToList()
        ?? new List<Booking>();

    var totalBookings = bookings.Count;
    var activeBookings = bookings.Count(x => x.IsActive);
    var cancelledBookings = bookings.Count(x => !x.IsActive);

    var totalRevenue = bookings
        .Where(x => x.IsActive)
        .Sum(x => x.TicketPrice);
}

<div class="container-fluid py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between
        align-items-center mb-4">

        <div>

            <h1 class="fw-bold text-primary mb-1">

                <i class="bi bi-ticket-perforated me-2"></i>

                Бронирования

            </h1>

            <p class="text-secondary mb-0">
                Управление бронированиями EURASIA BUS
            </p>

        </div>


        <div class="mt-3 mt-md-0">

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-primary">

                <i class="bi bi-speedometer2 me-2"></i>

                Панель администратора

            </a>

        </div>

    </div>


    <!-- =========================================================
         STATISTICS
         ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- TOTAL -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-secondary small mb-1">
                                Всего бронирований
                            </div>

                            <div class="display-6 fw-bold text-primary">
                                @totalBookings
                            </div>

                        </div>

                        <div class="display-5 text-primary">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVE -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-secondary small mb-1">
                                Активные
                            </div>

                            <div class="display-6 fw-bold text-success">
                                @activeBookings
                            </div>

                        </div>

                        <div class="display-5 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CANCELLED -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-secondary small mb-1">
                                Отменённые
                            </div>

                            <div class="display-6 fw-bold text-danger">
                                @cancelledBookings
                            </div>

                        </div>

                        <div class="display-5 text-danger">
                            <i class="bi bi-x-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SEARCH AND FILTER
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row g-3 align-items-end">

                <!-- SEARCH -->

                <div class="col-lg-6">

                    <label for="bookingSearch"
                           class="form-label fw-semibold">

                        <i class="bi bi-search me-2"></i>

                        Поиск бронирования

                    </label>

                    <input type="search"
                           id="bookingSearch"
                           class="form-control form-control-lg"
                           placeholder="PNR, пассажир, маршрут, пользователь..." />

                </div>


                <!-- FILTER -->

                <div class="col-lg-4">

                    <label for="statusFilter"
                           class="form-label fw-semibold">

                        <i class="bi bi-funnel me-2"></i>

                        Статус

                    </label>

                    <select id="statusFilter"
                            class="form-select form-select-lg">

                        <option value="all">
                            Все бронирования
                        </option>

                        <option value="active">
                            Активные
                        </option>

                        <option value="cancelled">
                            Отменённые
                        </option>

                    </select>

                </div>


                <!-- RESET -->

                <div class="col-lg-2">

                    <button type="button"
                            id="resetFilters"
                            class="btn btn-outline-secondary btn-lg w-100">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>

                        Сбросить

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ERROR MESSAGE
         ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         BOOKINGS TABLE
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white py-3">

            <div class="d-flex
                justify-content-between
                align-items-center">

                <h5 class="mb-0 fw-bold">

                    <i class="bi bi-list-ul me-2"></i>

                    Список бронирований

                </h5>

                <span class="badge bg-light text-primary"
                      id="visibleCount">

                    @totalBookings

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="bookingsTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-3">
                                PNR
                            </th>

                            <th>
                                Пассажир
                            </th>

                            <th>
                                Маршрут
                            </th>

                            <th>
                                Отправление
                            </th>

                            <th>
                                Место
                            </th>

                            <th>
                                Цена
                            </th>

                            <th>
                                Статус
                            </th>

                            <th class="text-center">
                                Действия
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var booking in bookings)
                        {
                            var passengerName =
                                booking.Passenger != null
                                    ? $"{booking.Passenger.FirstName} {booking.Passenger.LastName}"
                                    : "—";

                            var departureCity =
                                booking.BusTrip?.DepartureStop?.City
                                ?? "—";

                            var arrivalCity =
                                booking.BusTrip?.ArrivalStop?.City
                                ?? "—";

                            var userName =
                                booking.User?.UserName
                                ?? "—";

                            var seatNumber =
                                booking.BusTripSeat?.SeatNumber
                                ?? "—";

                            var searchText =
                                $"{booking.PnrCode} " +
                                $"{passengerName} " +
                                $"{departureCity} " +
                                $"{arrivalCity} " +
                                $"{userName} " +
                                $"{seatNumber}";

                            <tr class="booking-row"
                                data-status="@(booking.IsActive ? "active" : "cancelled")"
                                data-search="@searchText.ToLowerInvariant()">

                                <!-- PNR -->

                                <td class="px-3">

                                    <span class="badge bg-primary fs-6">

                                        @booking.PnrCode

                                    </span>

                                    <div class="small text-secondary mt-1">

                                        #@booking.BookingId

                                    </div>

                                </td>


                                <!-- PASSENGER -->

                                <td>

                                    <div class="fw-semibold">

                                        @passengerName

                                    </div>

                                    <div class="small text-secondary">

                                        @userName

                                    </div>

                                </td>


                                <!-- ROUTE -->

                                <td>

                                    <div class="fw-semibold">

                                        @departureCity

                                        <i class="bi bi-arrow-right mx-1 text-primary"></i>

                                        @arrivalCity

                                    </div>

                                    @if (booking.BusTrip?.Bus != null)
                                    {
                                        <div class="small text-secondary">

                                            <i class="bi bi-bus-front me-1"></i>

                                            @booking.BusTrip.Bus.Name

                                        </div>
                                    }

                                </td>


                                <!-- DEPARTURE -->

                                <td>

                                    @if (booking.BusTrip != null)
                                    {
                                        <div class="fw-semibold">

                                            @booking.BusTrip.DepartureDateTime.ToString("dd.MM.yyyy")

                                        </div>

                                        <div class="small text-secondary">

                                            @booking.BusTrip.DepartureDateTime.ToString("HH:mm")

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- SEAT -->

                                <td>

                                    <span class="badge bg-secondary fs-6">

                                        <i class="bi bi-person-square me-1"></i>

                                        @seatNumber

                                    </span>

                                </td>


                                <!-- PRICE -->

                                <td>

                                    <strong class="text-primary">

                                        € @booking.TicketPrice.ToString("N2")

                                    </strong>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (booking.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Активно

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Отменено

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex
                                        justify-content-center
                                        gap-2
                                        flex-wrap">

                                        @if (booking.IsActive)
                                        {
                                            <!-- CANCEL -->

                                            <form asp-controller="Admin"
                                                  asp-action="CancelBooking"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@booking.BookingId" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Отменить бронирование"
                                                        onclick="return confirm('Вы действительно хотите отменить это бронирование?');">

                                                    <i class="bi bi-x-circle me-1"></i>

                                                    Отменить

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- ACTIVATE -->

                                            <form asp-controller="Admin"
                                                  asp-action="ActivateBooking"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@booking.BookingId" />

                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm"
                                                        title="Восстановить бронирование"
                                                        onclick="return confirm('Восстановить это бронирование?');">

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Восстановить

                                                </button>

                                            </form>


                                            <!-- DELETE -->

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteBooking"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@booking.BookingId" />

                                                <button type="submit"
                                                        class="btn btn-outline-dark btn-sm"
                                                        title="Удалить бронирование"
                                                        onclick="return confirm('Вы действительно хотите удалить отменённое бронирование?');">

                                                    <i class="bi bi-trash me-1"></i>

                                                    Удалить

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- NO RESULTS -->

            <div id="noResults"
                 class="text-center py-5 d-none">

                <div class="display-4 text-secondary mb-3">

                    <i class="bi bi-search"></i>

                </div>

                <h5 class="fw-bold">
                    Бронирования не найдены
                </h5>

                <p class="text-secondary mb-0">
                    Измените поисковый запрос или фильтр.
                </p>

            </div>

        </div>

    </div>


    <!-- =========================================================
         FOOTER INFO
         ========================================================= -->

    <div class="row mt-4">

        <div class="col-md-6">

            <div class="text-secondary small">

                <i class="bi bi-info-circle me-1"></i>

                Всего отображено:
                <strong id="footerCount">
                    @totalBookings
                </strong>

                бронирований

            </div>

        </div>

        <div class="col-md-6 text-md-end">

            <div class="text-secondary small">

                EURASIA BUS

                <i class="bi bi-bus-front-fill mx-1 text-primary"></i>

                European Bus Booking System

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SEARCH / FILTER JAVASCRIPT
     ========================================================= -->
@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("bookingSearch");

            const statusFilter =
                document.getElementById("statusFilter");

            const resetButton =
                document.getElementById("resetFilters");

            const rows =
                document.querySelectorAll(".booking-row");

            const visibleCount =
                document.getElementById("visibleCount");

            const footerCount =
                document.getElementById("footerCount");

            const noResults =
                document.getElementById("noResults");


            function filterBookings() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusFilter.value;

                let count = 0;


                rows.forEach(function (row) {

                    const rowText =
                        row.dataset.search || "";

                    const rowStatus =
                        row.dataset.status || "";


                    const matchesSearch =
                        search === "" ||
                        rowText.includes(search);

                    const matchesStatus =
                        status === "all" ||
                        rowStatus === status;


                    if (matchesSearch && matchesStatus) {

                        row.classList.remove("d-none");

                        count++;

                    }
                    else {

                        row.classList.add("d-none");

                    }

                });


                visibleCount.textContent = count;

                footerCount.textContent = count;


                if (count === 0) {

                    noResults.classList.remove("d-none");

                }
                else {

                    noResults.classList.add("d-none");

                }

            }


            searchInput.addEventListener(
                "input",
                filterBookings
            );


            statusFilter.addEventListener(
                "change",
                filterBookings
            );


            resetButton.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    statusFilter.value = "all";

                    filterBookings();

                }
            );

        });

    </script>
}


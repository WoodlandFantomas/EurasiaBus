
@using EurasiaBus.Models
@model IEnumerable<BusStop>

@{
    ViewData["Title"] = "Автобусные остановки";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">
                <i class="bi bi-geo-alt-fill me-2"></i>
                Автобусные остановки
            </h1>

            <p class="text-muted mb-0">
                Управление остановками EURASIA BUS
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="AddBusStop"
           class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Добавить остановку
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Список остановок
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Название</th>
                                <th>Город</th>
                                <th>Страна</th>
                                <th>Адрес</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var stop in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @stop.BusStopId
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            <i class="bi bi-signpost-2 me-1 text-primary"></i>
                                            @stop.Name
                                        </div>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @stop.City
                                        </span>
                                    </td>

                                    <td>
                                        @stop.Country
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(stop.Address))
                                        {
                                            @stop.Address
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Не указан
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (stop.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Активна
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Неактивна
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <form asp-controller="Admin"
                                              asp-action="DeleteBusStop"
                                              asp-route-id="@stop.BusStopId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Вы действительно хотите удалить эту остановку?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Удалить остановку">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-geo-alt text-primary display-1"></i>

                    <h4 class="mt-3">
                        Остановок пока нет
                    </h4>

                    <p class="text-muted">
                        Добавьте первую автобусную остановку.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AddBusStop"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        Добавить первую остановку
                    </a>

                </div>
            }

        </div>

    </div>

</div>


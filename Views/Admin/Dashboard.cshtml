
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container-fluid mt-4">

    <!-- ===================================================== -->
    <!-- ЗАГОЛОВОК -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                🚌 Панель администратора
            </h2>

            <div class="text-muted">
                Управление системой Eurasia Bus
            </div>
        </div>

        <div>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                🏠 На главную
            </a>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- УПРАВЛЕНИЕ -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark text-white">
            <strong>Управление системой</strong>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- Маршруты TXT -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="RoutesText"
                       class="btn btn-primary w-100 py-3">

                        <div class="fs-3">
                            🚌
                        </div>

                        <div class="fw-bold">
                            Маршруты TXT
                        </div>

                        <small>
                            Просмотр и загрузка
                        </small>

                    </a>

                </div>


                <!-- Автобусы -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Buses"
                       class="btn btn-success w-100 py-3">

                        <div class="fs-3">
                            🚌
                        </div>

                        <div class="fw-bold">
                            Автобусы
                        </div>

                        <small>
                            Управление автобусами
                        </small>

                    </a>

                </div>


                <!-- Рейсы -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Trips"
                       class="btn btn-warning w-100 py-3">

                        <div class="fs-3">
                            📅
                        </div>

                        <div class="fw-bold">
                            Управление рейсами
                        </div>

                    </a>

                </div>


                <!-- Остановки -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Stops"
                       class="btn btn-info w-100 py-3">

                        <div class="fs-3">
                            📍
                        </div>

                        <div class="fw-bold">
                            Остановки
                        </div>

                    </a>

                </div>


                <!-- Пользователи -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="btn btn-secondary w-100 py-3">

                        <div class="fs-3">
                            👥
                        </div>

                        <div class="fw-bold">
                            Пользователи
                        </div>

                    </a>

                </div>


                <!-- Бронирования -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Bookings"
                       class="btn btn-danger w-100 py-3">

                        <div class="fs-3">
                            🎫
                        </div>

                        <div class="fw-bold">
                            Бронирования
                        </div>

                    </a>

                </div>


                <!-- Платежи -->
                <div class="col-md-4 col-lg-3">

                    <a asp-controller="Admin"
                       asp-action="Payments"
                       class="btn btn-dark w-100 py-3">

                        <div class="fs-3">
                            💳
                        </div>

                        <div class="fw-bold">
                            Платежи
                        </div>

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- СТАТИСТИКА -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">🎫</div>

                    <div class="text-muted">
                        Бронирования
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Bookings ?? 0)
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">🚌</div>

                    <div class="text-muted">
                        Автобусы
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Buses ?? 0)
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">📅</div>

                    <div class="text-muted">
                        Рейсы
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Trips ?? 0)
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">📍</div>

                    <div class="text-muted">
                        Остановки
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Stops ?? 0)
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">👥</div>

                    <div class="text-muted">
                        Пользователи
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Users ?? 0)
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-2 col-md-4 col-sm-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <div class="fs-2">💳</div>

                    <div class="text-muted">
                        Платежи
                    </div>

                    <div class="fs-3 fw-bold">
                        @(ViewBag.Payments ?? 0)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ВЫРУЧКА -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <div class="text-muted">
                        Общая сумма платежей
                    </div>

                    <div class="display-6 fw-bold">

                        @(
                            ViewBag.Revenue == null
                                ? "0.00"
                                : Convert.ToDecimal(ViewBag.Revenue)
                                    .ToString("N2")
                        )

                    </div>

                </div>

                <div class="col-md-4 text-md-end">

                    <span class="badge bg-success fs-6 px-3 py-2">
                        💰 Выручка
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ПОСЛЕДНИЕ БРОНИРОВАНИЯ -->
    <!-- ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between align-items-center">

                <strong>
                    Последние бронирования
                </strong>

                <a asp-controller="Admin"
                   asp-action="Bookings"
                   class="btn btn-sm btn-light">

                    Все бронирования →

                </a>

            </div>

        </div>


        <div class="card-body p-0">

            @if (ViewBag.LatestBookings != null &&
                 ViewBag.LatestBookings.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    №
                                </th>

                                <th>
                                    PNR
                                </th>

                                <th>
                                    Пассажир
                                </th>

                                <th>
                                    Рейс
                                </th>

                                <th>
                                    Место
                                </th>

                                <th>
                                    Дата
                                </th>

                                <th>
                                    Цена
                                </th>

                                <th>
                                    Статус
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var booking in ViewBag.LatestBookings)
                            {
                                <tr>

                                    <!-- BookingId -->
                                    <td>
                                        @booking.BookingId
                                    </td>


                                    <!-- PNR -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            booking.PnrCode))
                                        {
                                            <strong>
                                                @booking.PnrCode
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Пассажир -->
                                    <td>

                                        @if (booking.Passenger != null)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(
                                                booking.Passenger.FirstName) ||
                                                !string.IsNullOrWhiteSpace(
                                                booking.Passenger.LastName))
                                            {
                                                @booking.Passenger.FirstName
                                                @(" ")
                                                @booking.Passenger.LastName
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    —
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Рейс -->
                                    <td>

                                        @if (booking.BusTrip != null)
                                        {
                                            @if (booking.BusTrip.DepartureStop != null &&
                                                booking.BusTrip.ArrivalStop != null)
                                            {
                                                <span>
                                                    @booking.BusTrip.DepartureStop.City
                                                    →
                                                    @booking.BusTrip.ArrivalStop.City
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Рейс
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Место -->
                                    <td>

                                        @if (booking.BusTripSeat != null)
                                        {
                                            @booking.BusTripSeat.SeatNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Дата -->
                                    <td>

                                        @booking.BookingDate.ToLocalTime()
                                        .ToString("dd.MM.yyyy HH:mm")

                                    </td>


                                    <!-- Цена -->
                                    <td>

                                        @booking.TicketPrice.ToString("N2")

                                    </td>


                                    <!-- Статус -->
                                    <td>

                                        @if (booking.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Оплачено
                                            </span>
                                        }
                                        else if (booking.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Ожидает оплаты
                                            </span>
                                        }
                                        else if (booking.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Отменено
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @booking.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted p-5">

                    <div class="fs-1 mb-2">
                        🎫
                    </div>

                    <div>
                        Бронирований пока нет.
                    </div>

                </div>
            }

        </div>

    </div>

</div>

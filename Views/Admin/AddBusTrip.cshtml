
@using EurasiaBus.Models
@model BusTrip

@{
    ViewData["Title"] = "Добавить рейс";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <!-- Заголовок -->
            <div class="text-center mb-4">

                <div class="display-5 text-primary mb-2">
                    <i class="bi bi-signpost-2-fill"></i>
                </div>

                <h1 class="fw-bold text-primary">
                    Добавить автобусный рейс
                </h1>

                <p class="text-muted mb-0">
                    Создание нового рейса EURASIA BUS
                </p>

            </div>


            <!-- Форма -->
            <div class="card border-0 shadow-lg">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-signpost-2-fill me-2"></i>

                        Параметры рейса

                    </h5>

                </div>


                <div class="card-body p-4 p-lg-5">

                    <form asp-controller="Admin"
                          asp-action="AddBusTrip"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Общие ошибки -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- Автобус -->
                        <div class="mb-4">

                            <label asp-for="BusId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-bus-front-fill text-primary me-1"></i>

                                Автобус

                            </label>

                            <select asp-for="BusId"
                                    asp-items="ViewBag.Buses"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Выберите автобус --
                                </option>

                            </select>

                            <span asp-validation-for="BusId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Маршрут -->
                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <h6 class="fw-bold text-primary mb-4">

                                    <i class="bi bi-map-fill me-2"></i>

                                    Маршрут

                                </h6>


                                <div class="row g-4">

                                    <!-- Отправление -->
                                    <div class="col-md-6">

                                        <label asp-for="DepartureStopId"
                                               class="form-label fw-semibold">

                                            <i class="bi bi-geo-alt-fill text-success me-1"></i>

                                            Остановка отправления

                                        </label>

                                        <select asp-for="DepartureStopId"
                                                asp-items="ViewBag.DepartureStops"
                                                class="form-select">

                                            <option value="">
                                                -- Выберите остановку --
                                            </option>

                                        </select>

                                        <span asp-validation-for="DepartureStopId"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Прибытие -->
                                    <div class="col-md-6">

                                        <label asp-for="ArrivalStopId"
                                               class="form-label fw-semibold">

                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>

                                            Остановка прибытия

                                        </label>

                                        <select asp-for="ArrivalStopId"
                                                asp-items="ViewBag.ArrivalStops"
                                                class="form-select">

                                            <option value="">
                                                -- Выберите остановку --
                                            </option>

                                        </select>

                                        <span asp-validation-for="ArrivalStopId"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Время -->
                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <h6 class="fw-bold text-primary mb-4">

                                    <i class="bi bi-clock-fill me-2"></i>

                                    Расписание

                                </h6>


                                <div class="row g-4">

                                    <!-- Отправление -->
                                    <div class="col-md-6">

                                        <label asp-for="DepartureDateTime"
                                               class="form-label fw-semibold">

                                            <i class="bi bi-calendar-event text-primary me-1"></i>

                                            Дата и время отправления

                                        </label>

                                        <input asp-for="DepartureDateTime"
                                               type="datetime-local"
                                               class="form-control form-control-lg" />

                                        <span asp-validation-for="DepartureDateTime"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Прибытие -->
                                    <div class="col-md-6">

                                        <label asp-for="ArrivalDateTime"
                                               class="form-label fw-semibold">

                                            <i class="bi bi-calendar-check text-primary me-1"></i>

                                            Дата и время прибытия

                                        </label>

                                        <input asp-for="ArrivalDateTime"
                                               type="datetime-local"
                                               class="form-control form-control-lg" />

                                        <span asp-validation-for="ArrivalDateTime"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Цена -->
                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <h6 class="fw-bold text-primary mb-4">

                                    <i class="bi bi-currency-euro me-2"></i>

                                    Стоимость

                                </h6>


                                <div class="row">

                                    <div class="col-md-6">

                                        <label asp-for="Price"
                                               class="form-label fw-semibold">

                                            Цена билета (€)

                                        </label>

                                        <div class="input-group input-group-lg">

                                            <span class="input-group-text">
                                                €
                                            </span>

                                            <input asp-for="Price"
                                                   type="number"
                                                   min="0"
                                                   step="0.01"
                                                   class="form-control"
                                                   placeholder="50.00" />

                                        </div>

                                        <span asp-validation-for="Price"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Информация -->
                        <div class="alert alert-primary border-0">

                            <div class="d-flex">

                                <div class="me-3">

                                    <i class="bi bi-info-circle-fill fs-4"></i>

                                </div>

                                <div>

                                    <div class="fw-semibold mb-1">
                                        Автоматическое создание мест
                                    </div>

                                    <div class="small">

                                        После создания рейса система автоматически
                                        создаст места согласно количеству мест
                                        выбранного автобуса.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Кнопки -->
                        <div class="d-flex flex-wrap gap-2 pt-3 border-top">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                <i class="bi bi-check-circle me-1"></i>

                                Добавить рейс

                            </button>


                            <a asp-controller="Admin"
                               asp-action="BusTrips"
                               class="btn btn-outline-secondary btn-lg">

                                <i class="bi bi-arrow-left me-1"></i>

                                Отмена

                            </a>

                        </div>

                    </form>

                </div>

            </div>


            <!-- Подсказка -->
            <div class="alert alert-info border-0 shadow-sm mt-4">

                <i class="bi bi-lightbulb-fill me-2"></i>

                <strong>Совет:</strong>
                сначала добавьте автобус и остановки,
                затем создайте рейс.

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}


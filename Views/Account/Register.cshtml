@model EurasiaBus.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            Регистрация
                        </h2>

                        <p class="text-muted">
                            Создайте аккаунт EURASIA BUS
                        </p>

                    </div>


                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ИМЯ -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">
                                Имя
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Введите имя"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ФАМИЛИЯ -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                                Фамилия
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Введите фамилию"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- EMAIL -->
                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="Введите email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ПАРОЛЬ -->
                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Пароль
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   type="password"
                                   placeholder="Введите пароль"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ПОДТВЕРЖДЕНИЕ -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Повторите пароль
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Повторите пароль"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100 py-2">
                            Зарегистрироваться
                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Уже есть аккаунт?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="fw-semibold text-decoration-none">
                            Войти
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}